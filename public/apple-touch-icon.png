<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180" width="180" height="180">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e3a5f;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0f1f36;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f0c040;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#d4a017;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#b8860b;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="crossGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#f5d060;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#d4a017;stop-opacity:1" />
    </linearGradient>
  </defs>
  <circle cx="90" cy="90" r="90" fill="url(#bgGrad)"/>
  <circle cx="90" cy="90" r="82" fill="none" stroke="url(#goldGrad)" stroke-width="1.5" opacity="0.5"/>
  <rect x="82" y="30" width="16" height="72" rx="2" fill="url(#crossGrad)"/>
  <rect x="58" y="48" width="64" height="16" rx="2" fill="url(#crossGrad)"/>
  <circle cx="90" cy="56" r="5" fill="#1e3a5f" stroke="#f0c040" stroke-width="1"/>
  <circle cx="90" cy="56" r="2" fill="#f0c040"/>
  <g transform="translate(90, 120)">
    <path d="M-18,-8 Q-35,-12 -38,2 L-2,0 Z" fill="#f5f0e0" stroke="#d4a017" stroke-width="0.5"/>
    <path d="M18,-8 Q35,-12 38,2 L2,0 Z" fill="#f5f0e0" stroke="#d4a017" stroke-width="0.5"/>
  </g>
  <text x="90" y="150" text-anchor="middle" font-family="Georgia, serif" font-size="12" fill="#d4a017" font-weight="bold" letter-spacing="2">CACGM</text>
  <text x="90" y="164" text-anchor="middle" font-family="Georgia, serif" font-size="5.5" fill="#a0a8b8" letter-spacing="1">OF GOD MISSION</text>
</svg>
